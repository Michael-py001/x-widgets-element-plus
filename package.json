{
  "name": "x-widgets-element-plus",
  "version": "0.1.1",
  "description": "Vue 3 form component library built on Element Plus 2 with typed schema-driven forms",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist",
    ".agents",
    "LICENSE",
    "README.md",
    "README.en.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "author": "wushili",
  "keywords": ["vue", "vue3", "element-plus", "components", "typescript"],
  "engines": { "node": ">=18" },
  "peerDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.11.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "dayjs": "^1.11.18",
    "lodash-es": "^4.17.21"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitejs/plugin-vue-jsx": "^5.1.1",
    "@vue/language-core": "^3.3.14",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.1.0",
    "less": "^4.4.1",
    "sass-embedded": "^1.92.0",
    "shiki": "^2.5.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.2",
    "vite-plugin-dts": "^5.1.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.0.0"
  },
  "overrides": {
    "vitepress": {
      "vite": "$vite"
    }
  }
}
